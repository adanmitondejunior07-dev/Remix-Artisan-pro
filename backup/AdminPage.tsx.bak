              <div className="flex justify-between items-center">
                <span className="text-neutral-500 font-sans">Date & Heure :</span>
                <span className="text-neutral-700">
                  {new Date(selectedProofWithdrawal.date).toLocaleString('fr-FR')}
                </span>
              </div>
