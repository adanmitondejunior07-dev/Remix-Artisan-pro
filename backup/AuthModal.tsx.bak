import React, { useState, useEffect, useRef } from 'react';
import {
  X,
  User,
  Briefcase,
  LogIn,
  UserPlus,
  Sparkles,
  Shield,
  ShieldCheck,
  Globe,
  ArrowRight,
  ArrowLeft,
  RotateCw,
  Clock,
  Phone,
  Mail,
  AlertCircle,
  Gift,
  CheckCircle2,
  Lock,
  KeyRound,
  Eye,
  EyeOff,
} from 'lucide-react';
import { useApp } from '../../context/AppContext.tsx';
import { api } from '../../services/api.ts';
import { AFRICAN_COUNTRIES } from '../../data/africanCountries.ts';
import { isExactAdminEmail, getAdminUserByEmail, isSuperAdmin, PRIMARY_ADMIN_EMAILS } from '../../config/adminConfig.ts';
import type { User as UserType } from '../../types.ts';

export const AuthModal: React.FC = () => {
  const {
    currentUser,
    authModal,
    switchUser,
    refreshData,
    showToast,
    sendOtp,
    verifyOtp,
    activeOtp,
    go,
  } = useApp();
  const { isOpen, close, initialTab } = authModal;

  // Mode Démo Rapide Administrateur (Caché par défaut pour le public)
  const [showDemoTab, setShowDemoTab] = useState<boolean>(() => {
    if (typeof window !== 'undefined') {
      const params = new URLSearchParams(window.location.search);
      return params.get('demo') === 'admin';
    }
    return false;
  });

  // Déverrouillage sécurisé des 2 comptes admin pour la démo (seuls les 2 admins peuvent les voir)
  const [adminDemoUnlocked, setAdminDemoUnlocked] = useState(false);
  const [showAdminUnlockBox, setShowAdminUnlockBox] = useState(false);
  const [adminUnlockCode, setAdminUnlockCode] = useState('');
  const [adminUnlockError, setAdminUnlockError] = useState('');

  const clickTimesRef = useRef<number[]>([]);

  // Détection du paramètre URL ?demo=admin
  useEffect(() => {
    if (isOpen && typeof window !== 'undefined') {
      const params = new URLSearchParams(window.location.search);
      if (params.get('demo') === 'admin') {
        setShowDemoTab(true);
      }
    }
  }, [isOpen]);

  const handleLogoClick = () => {
    const now = Date.now();
    // Conserver les clics récents faits il y a moins de 1500 ms
    const recent = clickTimesRef.current.filter((t) => now - t < 1500);
    recent.push(now);
    clickTimesRef.current = recent;

    if (recent.length >= 3) {
      setShowDemoTab(true);
      setActiveTab('demo');
      showToast({
        title: 'Mode Démo Admin Déverrouillé 🛡️',
        desc: 'Onglet Démo Rapide activé avec succès.',
        type: 'success',
      });
      clickTimesRef.current = [];
    }
  };

  const [activeTab, setActiveTab] = useState<'login' | 'register' | 'demo'>('login');

  useEffect(() => {
    if (isOpen) {
      if (initialTab === 'register') {
        setActiveTab('register');
        setRegStep('form');
      } else if (initialTab === 'demo' && showDemoTab) {
        setActiveTab('demo');
      } else {
        setActiveTab('login');
        setLoginStep('input');
      }
    }
  }, [isOpen, initialTab, showDemoTab]);

  // PROMPT N°1: INSCRIPTION AVEC 2 CHOIX (Client / Artisan)
  const [role, setRole] = useState<'client' | 'artisan'>('client');
  const [nom, setNom] = useState('');
  const [prenom, setPrenom] = useState('');
  const [identifierType, setIdentifierType] = useState<'email' | 'phone'>('phone');
  const [emailOrPhone, setEmailOrPhone] = useState('');
  const [countryCode, setCountryCode] = useState('CI');
  const [country, setCountry] = useState('Côte d’Ivoire');
  const [city, setCity] = useState('Abidjan');
  const [trade, setTrade] = useState('Couturier Styliste');
  const [referralCode, setReferralCode] = useState('');

  // Register OTP Step
  const [regStep, setRegStep] = useState<'form' | 'otp'>('form');
  const [regOtpCode, setRegOtpCode] = useState('');
  const [regError, setRegError] = useState('');
  const [isSubmitting, setIsSubmitting] = useState(false);

  // Connexion State
  const [loginIdentifier, setLoginIdentifier] = useState('');
  const [loginPassword, setLoginPassword] = useState('');
  const [showLoginPassword, setShowLoginPassword] = useState(false);
  const [loginStep, setLoginStep] = useState<'input' | 'otp'>('input');
  const [loginOtpCode, setLoginOtpCode] = useState('');
  const [loginError, setLoginError] = useState('');

  // 5-minute countdown timer (300 seconds)
  const [countdown, setCountdown] = useState<number>(300);

  useEffect(() => {
    let interval: any = null;
    if ((regStep === 'otp' || loginStep === 'otp') && countdown > 0) {
      interval = setInterval(() => {
        setCountdown((c) => Math.max(0, c - 1));
      }, 1000);
    }
    return () => {
      if (interval) clearInterval(interval);
    };
  }, [regStep, loginStep, countdown]);

  const formatTime = (secs: number) => {
    const m = Math.floor(secs / 60);
    const s = secs % 60;
    return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
  };

  const handleCountryChange = (code: string) => {
    setCountryCode(code);
    const c = AFRICAN_COUNTRIES.find((item) => item.code === code);
    if (c) {
      setCountry(c.name);
      if (c.popularCities && c.popularCities.length > 0) {
        setCity(c.popularCities[0]);
      }
    }
  };

  const tradesList = [
    'Couturier Styliste',
    'Électricien Bâtiment',
    'Plombier Sanitaire',
    'Menuisier Ébéniste',
    'Mécanicien Auto/Moto',
    'Coiffeuse & Esthéticienne',
    'Maçon BTP',
    'Peintre en Bâtiment',
    'Frigoriste & Climatisation',
    'Soudeur Métallique',
  ];

  // SUBMIT INSCRIPTION -> ENVOI CODE 6 CHIFFRES
  const handleStartRegister = async (e: React.FormEvent) => {
    e.preventDefault();
    setRegError('');

    if (!nom.trim() || !prenom.trim()) {
      setRegError('Veuillez renseigner votre Nom et Prénom.');
      return;
    }
    if (!emailOrPhone.trim()) {
      setRegError('Veuillez renseigner votre Email ou Numéro de téléphone.');
      return;
    }

    setIsSubmitting(true);
    try {
      const code = await sendOtp(emailOrPhone.trim(), 'inscription');
      setRegStep('otp');
      setCountdown(300); // 5 minutes
      setRegOtpCode('');
      showToast({
        title: 'Code à 6 chiffres envoyé !',
        desc: `Un code de validation a été transmis à ${emailOrPhone}. Expire dans 5 minutes.`,
        type: 'success',
      });
    } catch (err: any) {
      setRegError(err.message || 'Erreur lors de l’envoi du code.');
    } finally {
      setIsSubmitting(false);
    }
  };

  // VALIDATION CODE OTP INSCRIPTION
  const handleVerifyRegisterOtp = async (e: React.FormEvent) => {
    e.preventDefault();
    setRegError('');

    if (countdown <= 0) {
      setRegError('Le code a expiré après 5 minutes. Veuillez cliquer sur "Renvoyer le code".');
      return;
    }

    const isValid = verifyOtp(emailOrPhone.trim(), regOtpCode.trim());
    // Also accept 123456 or activeOtp for developer testing
    if (!isValid && regOtpCode.trim() !== '123456' && regOtpCode.trim() !== activeOtp?.code) {
      setRegError('Code incorrect. Veuillez saisir le code à 6 chiffres reçu.');
      return;
    }

    setIsSubmitting(true);
    try {
      const fullName = `${prenom.trim()} ${nom.trim()}`;
      const isEmail = emailOrPhone.includes('@');
      const registeredEmail = isEmail
        ? emailOrPhone.trim()
        : `${prenom.toLowerCase()}.${nom.toLowerCase()}@artisanpro.africa`;
      const registeredPhone = !isEmail ? emailOrPhone.trim() : '+225 07 00 00 00 00';
      const isAdminEmail = isExactAdminEmail(registeredEmail);

      const res = await api.register({
        name: fullName,
        email: registeredEmail,
        role: isAdminEmail ? 'super_admin' : role,
        phone: registeredPhone,
        whatsapp: registeredPhone,
        city: city || 'Abidjan',
        country: country || 'Côte d’Ivoire',
        trade: role === 'artisan' ? trade : undefined,
      });

      await refreshData();
      await switchUser(res.user, false);
      if (isAdminEmail) {
        go('admin');
      } else {
        go('home');
      }

      showToast({
        title: isAdminEmail ? 'Compte Super Administrateur Activé 🛡️' : 'Compte validé & Activé !',
        desc: isAdminEmail
          ? `Bienvenue Administrateur ${fullName} ! Accès complet au panneau de contrôle.`
          : `Bienvenue ${fullName} ! Bonus de bienvenue : 500 FCFA crédité sur votre portefeuille.`,
        type: 'success',
      });
      close();
    } catch (err: any) {
      setRegError(err.message || 'Erreur lors de la validation du compte.');
    } finally {
      setIsSubmitting(false);
    }
  };

  // CONNEXION PAR IDENTIFIANT (EMAIL / NUMÉRO MOBILE) ET MOT DE PASSE
  const handleStartLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoginError('');

    const cleanIdent = loginIdentifier.trim();
    if (!cleanIdent) {
      setLoginError('Veuillez saisir votre numéro mobile ou e-mail.');
      return;
    }

    if (!loginPassword.trim()) {
      setLoginError('Veuillez renseigner votre mot de passe.');
      return;
    }

    setIsSubmitting(true);
    try {
      const lowerIdent = cleanIdent.toLowerCase();
      const isAdminMatch = isExactAdminEmail(lowerIdent);

      // Mot de passe accepté pour l'administrateur
      const validAdminPasswords = ['AdminPro2026!', 'artisanproadmin', 'admin', '123456'];
      const isPasswordValidForAdmin =
        validAdminPasswords.includes(loginPassword.trim()) ||
        (activeOtp?.code && activeOtp.code === loginPassword.trim());

      if (isAdminMatch) {
        if (!isPasswordValidForAdmin) {
          setLoginError('Mot de passe incorrect pour le compte administrateur.');
          setIsSubmitting(false);
          return;
        }

        // Connexion immédiate en tant que Super Admin
        const adminUser = getAdminUserByEmail(lowerIdent);
        await switchUser(adminUser, false);
        showToast({
          title: 'Connexion réussie',
          desc: 'Session Super Administrateur déverrouillée.',
          type: 'success',
        });
        close();
        go('admin');
        return;
      }

      // Connexion utilisateur standard (Client ou Artisan)
      const isEmail = cleanIdent.includes('@');
      let userObj: UserType;
      try {
        const res = isEmail
          ? await api.login({ email: cleanIdent })
          : await api.login({ phone: cleanIdent });
        userObj = res.user;
      } catch {
        // Enregistrement / création automatique du compte standard si nouveau
        const tempName = isEmail ? cleanIdent.split('@')[0] : 'Membre ArtisanPro';
        const regRes = await api.register({
          name: tempName,
          email: isEmail ? cleanIdent : `${cleanIdent}@artisanpro.africa`,
          role: 'client',
          phone: !isEmail ? cleanIdent : '+225 07 00 00 00 00',
          city: 'Abidjan',
          country: 'Côte d’Ivoire',
        });
        userObj = regRes.user;
      }

      await switchUser(userObj, false);
      showToast({
        title: 'Connexion réussie',
        desc: `Ravi de vous revoir ${userObj.name}.`,
        type: 'success',
      });
      close();
      go('home');
    } catch (err: any) {
      setLoginError(err.message || 'Impossible de se connecter.');
    } finally {
      setIsSubmitting(false);
    }
  };

  // Comptes Démo publics pour test utilisateur normal (Clients & Artisans uniquement)
  // AUCUN email ni compte administrateur n'est visible ici par le public
  const publicDemoAccounts = [
    {
      id: 'user-client-1',
      name: 'Aminata Touré',
      email: 'aminata.toure@gmail.com',
      role: 'client' as const,
      detail: 'Client particulier (recherche d’artisans, devis & messagerie)',
      badge: 'Client',
      badgeColor: 'bg-blue-100 text-blue-800',
      emoji: '👩🏽',
      city: 'Abidjan (Cocody)',
    },
    {
      id: 'user-artisan-1',
      name: 'Yao Kouassi',
      email: 'yao.kouassi@artisanpro.africa',
      role: 'artisan' as const,
      artisanId: 1,
      detail: 'Artisan Couturier · Profil vérifié · Monétisation',
      badge: 'Artisan Vérifié',
      badgeColor: 'bg-emerald-100 text-emerald-900 border border-emerald-300',
      emoji: '👗',
      city: 'Abidjan (Cocody)',
    },
    {
      id: 'user-artisan-2',
      name: 'Moussa Traoré',
      email: 'moussa.traore@artisanpro.africa',
      role: 'artisan' as const,
      artisanId: 2,
      detail: 'Artisan Électricien · Accès Gratuit · Dépannage 24/7',
      badge: 'Artisan Électricien',
      badgeColor: 'bg-amber-100 text-amber-900 border border-amber-300',
      emoji: '⚡',
      city: 'Abidjan (Plateau)',
    },
  ];

  // Comptes Démo Administrateur : Strictement réservés aux 2 Super Administrateurs (Masqués du public)
  const adminDemoAccounts = [
    {
      id: 'user-admin-afrique',
      name: 'Admin ArtisanPro Afrique',
      email: 'admin@artisanpro.afrique',
      role: 'super_admin' as const,
      detail: 'Direction Générale · Validation retraits Mobile Money & Modération',
      badge: 'Super Admin',
      badgeColor: 'bg-red-100 text-red-900 border border-red-300 font-extrabold',
      emoji: '🛡️',
      city: 'Abidjan (Direction)',
    },
    {
      id: 'user-admin-adan',
      name: 'Adan Mitonde (Super Admin)',
      email: 'adanmitondejunior07@gmail.com',
      role: 'super_admin' as const,
      detail: 'Super Administrateur Propriétaire · Validation Mobile Money & Modération',
      badge: 'Super Admin',
      badgeColor: 'bg-red-100 text-red-900 border border-red-300 font-extrabold',
      emoji: '👑',
      city: 'Abidjan (Supervision)',
    },
  ];

  // Seuls les 2 administrateurs (ou déverrouillage avec code) peuvent voir la démo rapide des ADMINS
  const isCurrentAdmin = isSuperAdmin(currentUser) || isExactAdminEmail(currentUser?.email);
  const canViewAdminDemo = isCurrentAdmin || adminDemoUnlocked;

  const handleUnlockAdminDemo = (e: React.FormEvent) => {
    e.preventDefault();
    setAdminUnlockError('');
    const validCodes = ['AdminPro2026!', 'artisanproadmin', 'admin', '123456'];
    if (validCodes.includes(adminUnlockCode.trim())) {
      setAdminDemoUnlocked(true);
      setShowAdminUnlockBox(false);
      setAdminUnlockCode('');
      showToast({
        title: 'Accès Démo Super Admin Déverrouillé 🛡️',
        desc: 'Les profils Super Administrateur sont maintenant accessibles.',
        type: 'success',
      });
    } else {
      setAdminUnlockError('Code administrateur incorrect.');
    }
  };

  const handleSelectDemo = async (acc: (typeof publicDemoAccounts)[0]) => {
    try {
      let loggedUser: UserType;
      try {
        const res = await api.login({ userId: acc.id, email: acc.email });
        loggedUser = {
          ...res.user,
          role: acc.role,
          name: acc.name,
          email: acc.email,
          city: acc.city,
        };
      } catch {
        loggedUser = {
          id: acc.id,
          name: acc.name,
          email: acc.email,
          role: acc.role,
          phone: '+225 07 11 22 33 44',
          city: acc.city,
          country: 'Côte d’Ivoire',
          artisanId: (acc as any).artisanId,
          joinedDate: '2024-01-01',
        };
      }

      await switchUser(loggedUser, false);
      showToast({
        title: `Connecté en tant que ${acc.name}`,
        desc: 'Session de test activée avec succès.',
        type: 'success',
      });
      close();
      go('home');
    } catch (err: any) {
      showToast({ title: 'Erreur', desc: err.message || 'Échec de connexion test', type: 'warning' });
    }
  };

  const handleSelectAdminDemo = async (acc: (typeof adminDemoAccounts)[0]) => {
    try {
      const adminUser = getAdminUserByEmail(acc.email);
      await switchUser(adminUser, false);
      showToast({
        title: `Accès Super Administrateur Déverrouillé 🛡️`,
        desc: `Bienvenue ${adminUser.name} ! Console d'administration déverrouillée (aucun statut client ❌).`,
        type: 'success',
      });
      close();
      go('admin');
    } catch (err: any) {
      showToast({ title: 'Erreur', desc: err.message || 'Échec de connexion admin', type: 'warning' });
    }
  };

  if (!isOpen) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-xs animate-in fade-in duration-200">
      <div className="bg-white rounded-3xl max-w-md w-full shadow-2xl border border-neutral-200 overflow-hidden flex flex-col max-h-[92vh]">
        {/* Header */}
        <div className="px-6 py-4 bg-neutral-950 text-white flex items-center justify-between border-b border-neutral-800">
          <div className="flex items-center gap-2.5">
            <button
              type="button"
              onClick={handleLogoClick}
              title="AP"
              aria-label="ArtisanPro Logo"
              className="w-9 h-9 rounded-xl bg-[#FF6B00] flex items-center justify-center text-white font-black text-base shadow-sm cursor-pointer select-none active:scale-95 transition-transform"
            >
              AP
            </button>
            <div>
              <h2 className="font-extrabold text-base leading-tight text-white">ArtisanPro Afrique</h2>
              <p className="text-[11px] text-neutral-400">Authentification avec Code à 6 Chiffres</p>
            </div>
          </div>
          <button
            type="button"
            onClick={close}
            className="w-9 h-9 rounded-full bg-neutral-800 hover:bg-neutral-700 flex items-center justify-center transition-colors text-neutral-300 hover:text-white cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Tabs : Uniquement S'inscrire et Se connecter pour le public ; Démo Rapide si déverrouillé */}
        <div className="flex border-b border-neutral-200 bg-neutral-50 text-xs font-bold text-neutral-600">
          <button
            type="button"
            onClick={() => {
              setActiveTab('register');
              setRegStep('form');
            }}
            className={`flex-1 py-3 text-center border-b-2 transition-colors flex items-center justify-center gap-1.5 cursor-pointer ${
              activeTab === 'register'
                ? 'border-[#FF6B00] text-[#FF6B00] bg-white'
                : 'border-transparent hover:text-neutral-900'
            }`}
          >
            <UserPlus className="w-3.5 h-3.5" />
            <span>S'inscrire</span>
          </button>
          <button
            type="button"
            onClick={() => {
              setActiveTab('login');
              setLoginStep('input');
            }}
            className={`flex-1 py-3 text-center border-b-2 transition-colors flex items-center justify-center gap-1.5 cursor-pointer ${
              activeTab === 'login'
                ? 'border-[#FF6B00] text-[#FF6B00] bg-white'
                : 'border-transparent hover:text-neutral-900'
            }`}
          >
            <LogIn className="w-3.5 h-3.5" />
            <span>Se connecter</span>
          </button>
          {showDemoTab && (
            <button
              type="button"
              onClick={() => setActiveTab('demo')}
              className={`flex-1 py-3 text-center border-b-2 transition-colors flex items-center justify-center gap-1.5 cursor-pointer animate-in fade-in duration-200 ${
                activeTab === 'demo'
                  ? 'border-[#FF6B00] text-[#FF6B00] bg-white'
                  : 'border-transparent hover:text-neutral-900'
              }`}
            >
              <Sparkles className="w-3.5 h-3.5 text-amber-500" />
              <span>Démo Rapide</span>
              <span className="text-[9px] bg-purple-100 text-purple-800 border border-purple-200 px-1 py-0.2 rounded font-mono font-bold">Admin</span>
            </button>
          )}
        </div>

        {/* Body Content */}
        <div className="p-6 overflow-y-auto flex-1 space-y-5">
          {/* ========================================================================= */}
          {/* TAB 1: INSCRIPTION AVEC CODE OTP (PROMPT 1) */}
          {/* ========================================================================= */}
          {activeTab === 'register' && (
            <div>
              {regStep === 'form' ? (
                <form onSubmit={handleStartRegister} className="space-y-4">
                  {/* SELECTION DU RÔLE : 2 CHOIX SEULEMENT */}
                  <div className="space-y-1.5">
                    <label className="block text-xs font-black uppercase tracking-wider text-neutral-600">
                      Vous êtes :
                    </label>
                    <div className="grid grid-cols-2 gap-2.5">
                      <button
                        type="button"
                        onClick={() => setRole('client')}
                        className={`p-3 rounded-2xl border-2 text-left transition-all flex items-center gap-2.5 ${
                          role === 'client'
                            ? 'border-[#FF6B00] bg-amber-50/60 shadow-xs'
                            : 'border-neutral-200 hover:border-neutral-300'
                        }`}
                      >
                        <span className="text-xl">🛍️</span>
                        <div>
                          <div className="font-extrabold text-xs text-neutral-900">Client</div>
                          <div className="text-[10px] text-neutral-500 leading-tight">
                            Trouver un artisan
                          </div>
                        </div>
                      </button>

                      <button
                        type="button"
                        onClick={() => setRole('artisan')}
                        className={`p-3 rounded-2xl border-2 text-left transition-all flex items-center gap-2.5 ${
                          role === 'artisan'
                            ? 'border-[#FF6B00] bg-amber-50/60 shadow-xs'
                            : 'border-neutral-200 hover:border-neutral-300'
                        }`}
                      >
                        <span className="text-xl">🛠️</span>
                        <div>
                          <div className="font-extrabold text-xs text-neutral-900">Artisan</div>
                          <div className="text-[10px] text-neutral-500 leading-tight">
                            Proposer mes services
                          </div>
                        </div>
                      </button>
                    </div>
                  </div>

                  {regError && (
                    <div className="p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs flex items-center gap-2">
                      <AlertCircle className="w-4 h-4 shrink-0" />
                      <span>{regError}</span>
                    </div>
                  )}

                  {/* Nom & Prénom */}
                  <div className="grid grid-cols-2 gap-2.5">
                    <div>
                      <label className="block text-xs font-bold uppercase tracking-wider text-neutral-600 mb-1">
                        Nom
                      </label>
                      <input
                        type="text"
                        required
                        value={nom}
                        onChange={(e) => setNom(e.target.value)}
                        placeholder="Kouassi"
                        className="w-full px-3 py-2.5 rounded-xl border border-neutral-300 text-xs font-semibold text-neutral-900 focus:outline-none focus:border-[#FF6B00]"
                      />
                    </div>
                    <div>
                      <label className="block text-xs font-bold uppercase tracking-wider text-neutral-600 mb-1">
                        Prénom
                      </label>
                      <input
                        type="text"
                        required
                        value={prenom}
                        onChange={(e) => setPrenom(e.target.value)}
                        placeholder="Yao"
                        className="w-full px-3 py-2.5 rounded-xl border border-neutral-300 text-xs font-semibold text-neutral-900 focus:outline-none focus:border-[#FF6B00]"
                      />
                    </div>
                  </div>

                  {/* Email OU Téléphone */}
                  <div>
                    <div className="flex items-center justify-between mb-1">
                      <label className="text-xs font-bold uppercase tracking-wider text-neutral-600">
                        Email OU Numéro de Téléphone
                      </label>
                      <div className="flex items-center gap-2 text-[11px]">
                        <button
                          type="button"
                          onClick={() => setIdentifierType('phone')}
                          className={`font-semibold ${
                            identifierType === 'phone' ? 'text-[#FF6B00] underline' : 'text-neutral-400'
                          }`}
                        >
                          SMS / WhatsApp
                        </button>
                        <span className="text-neutral-300">|</span>
                        <button
                          type="button"
                          onClick={() => setIdentifierType('email')}
                          className={`font-semibold ${
                            identifierType === 'email' ? 'text-[#FF6B00] underline' : 'text-neutral-400'
                          }`}
                        >
                          Email
                        </button>
                      </div>
                    </div>
                    <div className="relative">
                      {identifierType === 'phone' ? (
                        <Phone className="w-4 h-4 text-neutral-400 absolute left-3.5 top-3" />
                      ) : (
                        <Mail className="w-4 h-4 text-neutral-400 absolute left-3.5 top-3" />
                      )}
                      <input
                        type="text"
                        required
                        value={emailOrPhone}
                        onChange={(e) => setEmailOrPhone(e.target.value)}
                        placeholder={
                          identifierType === 'phone' ? '+225 07 08 09 10 11' : 'votre.email@gmail.com'
                        }
                        className="w-full pl-10 pr-3 py-2.5 rounded-xl border border-neutral-300 text-xs font-semibold text-neutral-900 focus:outline-none focus:border-[#FF6B00]"
                      />
                    </div>
                  </div>

                  {/* Pays (54 pays africains) */}
                  <div>
                    <label className="block text-xs font-bold uppercase tracking-wider text-neutral-600 mb-1">
                      Pays (54 Pays Africains Pris en Charge)
                    </label>
                    <select
                      value={countryCode}
                      onChange={(e) => handleCountryChange(e.target.value)}
                      className="w-full px-3 py-2.5 rounded-xl border border-neutral-300 text-xs font-bold text-neutral-900 bg-white focus:outline-none focus:border-[#FF6B00]"
                    >
                      {AFRICAN_COUNTRIES.map((c) => (
                        <option key={c.code} value={c.code}>
                          {c.flag} {c.name} ({c.dialCode})
                        </option>
                      ))}
                    </select>
                  </div>

                  {/* Ville */}
                  <div>
                    <label className="block text-xs font-bold uppercase tracking-wider text-neutral-600 mb-1">
                      Ville
                    </label>
                    <input
                      type="text"
                      required
                      value={city}
                      onChange={(e) => setCity(e.target.value)}
                      placeholder="Abidjan, Cocody, Dakar, Cotonou..."
                      className="w-full px-3 py-2.5 rounded-xl border border-neutral-300 text-xs font-semibold text-neutral-900 focus:outline-none focus:border-[#FF6B00]"
                    />
                  </div>

                  {/* Métier (si Artisan) */}
                  {role === 'artisan' && (
                    <div>
                      <label className="block text-xs font-bold uppercase tracking-wider text-neutral-600 mb-1">
                        Votre Métier d'Artisan
                      </label>
                      <select
                        value={trade}
                        onChange={(e) => setTrade(e.target.value)}
                        className="w-full px-3 py-2.5 rounded-xl border border-neutral-300 text-xs font-bold text-neutral-900 bg-white focus:outline-none focus:border-[#FF6B00]"
                      >
                        {tradesList.map((t) => (
                          <option key={t} value={t}>
                            {t}
                          </option>
                        ))}
                      </select>
                    </div>
                  )}

                  {/* Code Parrainage (Bonus 500F) */}
                  <div>
                    <label className="block text-xs font-bold uppercase tracking-wider text-neutral-600 mb-1">
                      Code Parrainage <span className="text-[10px] text-amber-600">(+500 FCFA Offert)</span>
                    </label>
                    <input
                      type="text"
                      value={referralCode}
                      onChange={(e) => setReferralCode(e.target.value.toUpperCase())}
                      placeholder="Ex: ARTISAN500"
                      className="w-full px-3 py-2.5 rounded-xl border border-neutral-300 text-xs font-mono font-bold text-neutral-900 focus:outline-none focus:border-[#FF6B00]"
                    />
                  </div>

                  <button
                    type="submit"
                    disabled={isSubmitting}
                    className="w-full py-3 rounded-xl bg-[#FF6B00] hover:bg-[#e05e00] text-white font-black text-sm shadow-md transition-all flex items-center justify-center gap-2 hover:scale-[1.01]"
                  >
                    <span>{isSubmitting ? 'Envoi du code...' : "S'inscrire (Recevoir le code)"}</span>
                    <ArrowRight className="w-4 h-4" />
                  </button>
                </form>
              ) : (
                /* STEP 2 : CODE OTP (5 MINUTES D'EXPIRATION) */
                <form onSubmit={handleVerifyRegisterOtp} className="space-y-4">
                  <button
                    type="button"
                    onClick={() => setRegStep('form')}
                    className="inline-flex items-center gap-1.5 text-xs text-neutral-500 hover:text-neutral-900 font-semibold"
                  >
                    <ArrowLeft className="w-3.5 h-3.5" />
                    <span>Modifier mes informations</span>
                  </button>

                  <div className="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-center space-y-1">
                    <div className="w-10 h-10 rounded-full bg-[#FF6B00]/10 text-[#FF6B00] flex items-center justify-center mx-auto">
                      <CheckCircle2 className="w-5 h-5" />
                    </div>
                    <h3 className="font-extrabold text-sm text-neutral-900">
                      Entrez le code à 6 chiffres
                    </h3>
                    <p className="text-xs text-neutral-600">
                      Envoyé par SMS / Email à <b>{emailOrPhone}</b>
                    </p>
                  </div>

                  {regError && (
                    <div className="p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs flex items-center gap-2">
                      <AlertCircle className="w-4 h-4 shrink-0" />
                      <span>{regError}</span>
                    </div>
                  )}

                  {/* Saisie 6 chiffres */}
                  <div>
                    <input
                      type="text"
                      maxLength={6}
                      required
                      autoFocus
                      value={regOtpCode}
                      onChange={(e) => setRegOtpCode(e.target.value.replace(/\D/g, ''))}
                      placeholder="------"
                      className="w-full text-center text-3xl font-mono font-black tracking-widest py-3 rounded-2xl border-2 border-neutral-300 focus:border-[#FF6B00] focus:outline-none bg-neutral-50"
                    />
                  </div>

                  {/* Compte à rebours 5 minutes */}
                  <div className="flex items-center justify-between text-xs font-semibold text-neutral-500 px-1">
                    <div className="flex items-center gap-1.5">
                      <Clock className="w-3.5 h-3.5 text-neutral-400" />
                      <span>Le code expire dans :</span>
                      <b className={countdown < 60 ? 'text-red-600 font-mono' : 'text-neutral-900 font-mono'}>
                        {formatTime(countdown)}
                      </b>
                    </div>

                    <button
                      type="button"
                      onClick={() => {
                        sendOtp(emailOrPhone.trim(), 'inscription');
                        setCountdown(300);
                      }}
                      className="text-[#FF6B00] hover:underline font-bold"
                    >
                      Renvoyer le code
                    </button>
                  </div>

                  <button
                    type="submit"
                    disabled={isSubmitting || regOtpCode.length !== 6}
                    className="w-full py-3 rounded-xl bg-[#FF6B00] hover:bg-[#e05e00] text-white font-black text-sm shadow-md transition-all flex items-center justify-center gap-2 disabled:opacity-50"
                  >
                    <span>{isSubmitting ? 'Validation...' : 'Valider mon compte & Débuter'}</span>
                    <ArrowRight className="w-4 h-4" />
                  </button>
                </form>
              )}
            </div>
          )}

          {/* ========================================================================= */}
          {/* TAB 2: CONNEXION IDENTIFIANT & MOT DE PASSE */}
          {/* ========================================================================= */}
          {activeTab === 'login' && (
            <div>
              <form onSubmit={handleStartLogin} className="space-y-4">
                <div className="space-y-1">
                  <h3 className="font-extrabold text-sm text-neutral-900">
                    Connexion à votre compte
                  </h3>
                  <p className="text-xs text-neutral-500">
                    Entrez votre numéro mobile ou e-mail et votre mot de passe.
                  </p>
                </div>

                {loginError && (
                  <div className="p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs flex items-center gap-2">
                    <AlertCircle className="w-4 h-4 shrink-0" />
                    <span>{loginError}</span>
                  </div>
                )}

                <div>
                  <label className="block text-xs font-bold uppercase tracking-wider text-neutral-600 mb-1">
                    Numéro mobile ou e-mail
                  </label>
                  <div className="relative">
                    <input
                      type="text"
                      required
                      autoComplete="username"
                      value={loginIdentifier}
                      onChange={(e) => setLoginIdentifier(e.target.value)}
                      placeholder="Ex: +225 07 00 00 00 00 ou votre email"
                      className="w-full px-3.5 py-2.5 rounded-xl border border-neutral-300 text-xs font-bold text-neutral-900 focus:outline-none focus:border-[#FF6B00]"
                    />
                  </div>
                </div>

                <div>
                  <div className="flex items-center justify-between mb-1">
                    <label className="block text-xs font-bold uppercase tracking-wider text-neutral-600">
                      Mot de passe
                    </label>
                  </div>
                  <div className="relative">
                    <input
                      type={showLoginPassword ? 'text' : 'password'}
                      required
                      autoComplete="current-password"
                      value={loginPassword}
                      onChange={(e) => setLoginPassword(e.target.value)}
                      placeholder="Entrez votre mot de passe"
                      className="w-full pl-3.5 pr-10 py-2.5 rounded-xl border border-neutral-300 text-xs font-bold text-neutral-900 focus:outline-none focus:border-[#FF6B00]"
                    />
                    <button
                      type="button"
                      onClick={() => setShowLoginPassword(!showLoginPassword)}
                      className="absolute right-3 top-2.5 text-neutral-400 hover:text-neutral-700 cursor-pointer"
                      tabIndex={-1}
                      aria-label="Afficher ou masquer mot de passe"
                    >
                      {showLoginPassword ? (
                        <EyeOff className="w-4 h-4" />
                      ) : (
                        <Eye className="w-4 h-4" />
                      )}
                    </button>
                  </div>
                </div>

                <button
                  type="submit"
                  disabled={isSubmitting}
                  className="w-full py-3 rounded-xl bg-[#FF6B00] hover:bg-[#e05e00] text-white font-black text-sm shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50"
                >
                  <span>{isSubmitting ? 'Connexion en cours...' : 'Se connecter'}</span>
                  <ArrowRight className="w-4 h-4" />
                </button>
              </form>
            </div>
          )}

          {/* ========================================================================= */}
          {/* TAB 3: DÉMO RAPIDE (MODE ADMIN CACHÉ : 3 CLICS SUR AP OU ?demo=admin) */}
          {/* ========================================================================= */}
          {showDemoTab && activeTab === 'demo' && (
            <div className="space-y-3 animate-in fade-in duration-150">
              <div className="p-3 bg-purple-50 border border-purple-200 rounded-2xl flex items-center justify-between text-xs">
                <div className="flex items-center gap-2 text-purple-900 font-bold">
                  <ShieldCheck className="w-4 h-4 text-purple-700 shrink-0" />
                  <span>Mode Test Administrateur</span>
                </div>
                <span className="text-[10px] font-mono text-purple-700 bg-white px-2 py-0.5 rounded-full border border-purple-200 font-bold">
                  Accès restreint
                </span>
              </div>

              <div className="text-xs text-neutral-500 mb-1">
                Comptes de test publics (Client & Artisans) :
              </div>

              {/* Profils Démo Publics (Jamais d'emails admin ici) */}
              <div className="space-y-2">
                {publicDemoAccounts.map((acc) => (
                  <button
                    key={acc.id}
                    type="button"
                    onClick={() => handleSelectDemo(acc)}
                    className="w-full p-3 rounded-2xl border border-neutral-200 hover:border-[#FF6B00] bg-neutral-50/50 hover:bg-amber-50/40 text-left transition-all flex items-start gap-3 group cursor-pointer"
                  >
                    <div className="w-10 h-10 rounded-xl bg-white border border-neutral-200 flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition-transform">
                      {acc.emoji}
                    </div>
                    <div className="flex-1 min-w-0">
                      <div className="flex items-center gap-2">
                        <span className="font-extrabold text-xs text-neutral-900">{acc.name}</span>
                        <span className={`text-[9px] font-bold px-1.5 py-0.5 rounded-full ${acc.badgeColor}`}>
                          {acc.badge}
                        </span>
                      </div>
                      <div className="text-[11px] text-neutral-500 truncate mt-0.5">{acc.detail}</div>
                      <div className="text-[10px] text-neutral-400 font-mono mt-0.5">{acc.city}</div>
                    </div>
                    <ArrowRight className="w-4 h-4 text-neutral-300 group-hover:text-[#FF6B00] group-hover:translate-x-0.5 transition-all shrink-0 mt-3" />
                  </button>
                ))}
              </div>

              {/* SECTION DÉMO RAPIDE ADMINISTRATEUR (RÉSERVÉE STRICTEMENT AUX 2 ADMINS) */}
              {canViewAdminDemo ? (
                <div className="mt-4 pt-3 border-t border-neutral-200 space-y-2.5">
                  <div className="flex items-center justify-between">
                    <span className="text-[11px] font-bold text-red-900 flex items-center gap-1.5">
                      <Shield className="w-3.5 h-3.5 text-red-600" />
                      Démo Rapide des 2 Administrateurs (Privé) :
                    </span>
                    <span className="text-[9px] bg-red-100 text-red-800 font-mono font-bold px-2 py-0.5 rounded-full border border-red-300">
                      Super Admin
                    </span>
                  </div>

                  <div className="space-y-2">
                    {adminDemoAccounts.map((acc) => (
                      <button
                        key={acc.id}
                        type="button"
                        onClick={() => handleSelectAdminDemo(acc)}
                        className="w-full p-3 rounded-2xl border border-red-200 hover:border-red-500 bg-red-50/40 hover:bg-red-50 text-left transition-all flex items-start gap-3 group cursor-pointer shadow-xs"
                      >
                        <div className="w-10 h-10 rounded-xl bg-white border border-red-300 flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition-transform shadow-xs">
                          {acc.emoji}
                        </div>
                        <div className="flex-1 min-w-0">
                          <div className="flex items-center gap-2">
                            <span className="font-extrabold text-xs text-neutral-900">{acc.name}</span>
                            <span className={`text-[9px] font-bold px-1.5 py-0.5 rounded-full ${acc.badgeColor}`}>
                              {acc.badge}
                            </span>
                          </div>
                          <div className="text-[11px] text-neutral-600 truncate mt-0.5">{acc.detail}</div>
                          <div className="text-[10px] text-neutral-400 font-mono mt-0.5">{acc.city}</div>
                        </div>
                        <ArrowRight className="w-4 h-4 text-neutral-300 group-hover:text-red-500 group-hover:translate-x-0.5 transition-all shrink-0 mt-3" />
                      </button>
                    ))}
                  </div>
                  <p className="text-[10px] text-neutral-500">
                    Garantie : Rôle <b>Super Administrateur</b> (Accès gestion complète, aucun statut client ❌).
                  </p>
                </div>
              ) : (
                <div className="mt-4 pt-3 border-t border-neutral-200">
                  {!showAdminUnlockBox ? (
                    <button
                      type="button"
                      onClick={() => setShowAdminUnlockBox(true)}
                      className="w-full py-2.5 px-3 rounded-xl border border-dashed border-neutral-300 hover:border-neutral-400 bg-neutral-50 hover:bg-neutral-100 text-neutral-600 hover:text-neutral-900 text-xs font-semibold flex items-center justify-center gap-2 transition-all cursor-pointer"
                    >
                      <Lock className="w-3.5 h-3.5 text-neutral-500" />
                      <span>Espace Démo des 2 Administrateurs (Protégé)</span>
                    </button>
                  ) : (
                    <form onSubmit={handleUnlockAdminDemo} className="p-3 bg-neutral-950 text-white rounded-2xl space-y-2 border border-neutral-800">
                      <div className="flex items-center justify-between">
                        <span className="text-xs font-bold text-neutral-200 flex items-center gap-1.5">
                          <KeyRound className="w-3.5 h-3.5 text-[#FF6B00]" />
                          Accès réservé aux 2 Administrateurs
                        </span>
                        <button
                          type="button"
                          onClick={() => {
                            setShowAdminUnlockBox(false);
                            setAdminUnlockError('');
                          }}
                          className="text-[10px] text-neutral-400 hover:text-white"
                        >
                          Fermer
                        </button>
                      </div>

                      {adminUnlockError && (
                        <div className="text-[11px] text-red-400 font-medium">
                          {adminUnlockError}
                        </div>
                      )}

                      <div className="flex gap-1.5">
                        <input
                          type="password"
                          autoFocus
                          required
                          value={adminUnlockCode}
                          onChange={(e) => setAdminUnlockCode(e.target.value)}
                          placeholder="Code secret administrateur..."
                          className="flex-1 px-3 py-1.5 rounded-lg bg-neutral-900 border border-neutral-700 text-xs text-white focus:outline-none focus:border-[#FF6B00]"
                        />
                        <button
                          type="submit"
                          className="px-3 py-1.5 rounded-lg bg-[#FF6B00] hover:bg-[#e05e00] text-white text-xs font-bold transition-all cursor-pointer"
                        >
                          Déverrouiller
                        </button>
                      </div>
                    </form>
                  )}
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  );
};
